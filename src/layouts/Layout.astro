---
import "../styles/global.css";
import { Font } from "astro:assets"
import background from "../assets/red-background.png"
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Temperance Garden Project</title>
		<Font cssVariable="--font-dokdo" />
	</head>
	<body>
		<img src={background.src} class="absolute inset-0 h-dvh w-screen object-cover"/>
		<slot />
		<script is:inline src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"></script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
