---
import "../styles/global.css";
import Plant from "./Plant.astro";
import back from "../assets/back.png";
import next from "../assets/next.png";
import type { GiftType } from "../utils/types";
import SanityImage from "./SanityImage.astro";

const { slug, description, gifts, images } = Astro.props;
const { imgSrc, modalWidth, modalClass } = Astro.props.activePlant;

console.log(images);
---

<div class="embla relative size-full">
  <div class="embla__viewport h-[80%] w-full overflow-x-hidden">
    <div class="embla__container flex touch-pan-y overflow-y-visible">
      <!-- Slide 1 -->
      <div class="embla__slide flex min-w-0 flex-[0_0_100%] flex-col items-center">
        <Plant
          slug={slug}
          imgSrc={imgSrc}
          variant="img"
          class={modalClass}
          modalWidth={modalWidth}
        />
        <p class="text-3xl/snug text-body">{description}</p>
      </div>
      <!-- Slide 2 -->
      <div class="embla__slide min-w-0 flex-[0_0_100%]">
        <h2 class="text-4xl">Gifts</h2>
        <ul class="ml-8 list-disc text-3xl">
          {gifts.map((gift: GiftType) => (
            <li>
              <span>{gift.description}</span>
              <span>
                {gift.sources?.map((source: string, i: number) => (
                  <span>
                    [
                    <a href={source} class="underline text-blue-700">
                      {gift.sources.length > 1 ? `Source ${i + 1}` : `Source`}
                    </a>
                    ]
                  </span>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </div>
      <!-- Slide 3 -->
      <div class="embla__slide min-w-0 flex-[0_0_100%]">
        <div class="flex flex-col gap-8">
          {images &&
            images.map((image: any) => (
              <>
                <SanityImage image={image} alt="placeholder" width={250} />
                <figcaption>Photo caption</figcaption>
              </>
            ))}
        </div>
      </div>
    </div>
  </div>

  <div class="embla__dots flex h-4 justify-center gap-2"></div>

  <div class="mt-6 flex flex-row justify-center gap-8">
    <button
      class="embla__prev hidden cursor-pointer
          lg:flex"
    >
      <img src={back.src} class="h-15 w-auto" />
    </button>
    <button
      class="embla__next hidden cursor-pointer
          lg:flex"
    >
      <img src={next.src} class="h-15 w-auto" />
    </button>
  </div>
</div>

<script>
  import EmblaCarousel from "embla-carousel";

  const carousels = document.querySelectorAll(".embla");

  carousels.forEach((carousel) => {
    if (carousel) {
      const viewportNode = carousel.querySelector(
        ".embla__viewport",
      ) as HTMLElement;
      const dotsNode = carousel.querySelector(".embla__dots");
      const prevButtonNode = carousel.querySelector(".embla__prev");
      const nextButtonNode = carousel.querySelector(".embla__next");

      const emblaApi = EmblaCarousel(viewportNode, { loop: false });

      // Generate dot buttons
      const generateDots = () => {
        const scrollSnaps = emblaApi.scrollSnapList();

        dotsNode.innerHTML = scrollSnaps
          .map(
            () =>
              `<button class="embla__dot bg-gray-400 size-3 rounded-full" type="button"></button>`,
          )
          .join("");
      };

      // Handle dot clicks
      const addClickHandlers = () => {
        const dots = Array.from(dotsNode.querySelectorAll(".embla__dot"));
        dots.forEach((dot, index) => {
          dot.addEventListener("click", () => emblaApi.scrollTo(index));
        });
      };

      // Update selected dot state
      const updateDots = () => {
        const dots = Array.from(dotsNode.querySelectorAll(".embla__dot"));
        const previousIndex = emblaApi.previousScrollSnap();
        const selectedIndex = emblaApi.selectedScrollSnap();

        if (dots[previousIndex]) {
          dots[previousIndex].classList.remove("bg-gray-600");
          dots[previousIndex].classList.add("bg-gray-400");
        }
        if (dots[selectedIndex]) {
          dots[selectedIndex].classList.remove("bg-gray-400");
          dots[selectedIndex].classList.add("bg-gray-600");
        }
      };

      // Initialize
      generateDots();
      addClickHandlers();
      updateDots();

      // Listen to Embla events to update state
      emblaApi.on("select", updateDots);
      emblaApi.on("reInit", () => {
        generateDots();
        addClickHandlers();
        updateDots();
      });

      prevButtonNode?.addEventListener(
        "click",
        () => emblaApi.scrollPrev(),
        false,
      );
      nextButtonNode?.addEventListener(
        "click",
        () => emblaApi.scrollNext(),
        false,
      );
    }
  });
</script>
