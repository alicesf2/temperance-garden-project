---
import "../styles/global.css"
import Plant from "./Plant.astro";

const { id, description, gifts } = Astro.props;
const { imgSrc, modalWidth, modalClass } = Astro.props.activePlant
---

<div class="embla size-full">
  <div class="embla__viewport h-[80%] w-full overflow-hidden">
    <div class="embla__container flex touch-pan-y">
        <!-- Slide 1 -->
      <div class="embla__slide min-w-0 flex-[0_0_100%]">
            <Plant
                id="primrose"
                imgSrc={imgSrc}
                imgWidth={modalWidth}
                class={modalClass}
            />
            <p class="text-3xl/snug text-body">
                {description}
            </p>
      </div>
      <!-- Slide 2 -->
      <div class="embla__slide min-w-0 flex-[0_0_100%]">
        <h2 class="text-4xl">Gifts</h2>
        {gifts.map((gift: string, i: number) => (
            <span class="text-3xl/snug text-body">
                {gift}{i < gifts.length - 1 && ", "}
            </span>
        ))}
      </div>
      <!-- Slide 3 -->
      <div class="embla__slide min-w-0 flex-[0_0_100%]">Slide 3</div>
    </div>
  </div>

  <button class="
    embla__prev hidden
    lg:flex
  ">Scroll to prev</button>
  <button class="
    embla__next hidden
    lg:flex
  ">Scroll to next</button>
</div>

<script>
    import EmblaCarousel from 'embla-carousel'
    
    const carousels = document.querySelectorAll('.embla')

    carousels.forEach((carousel) => {
        if (carousel) {
            const viewportNode = carousel.querySelector('.embla__viewport') as HTMLElement
            const prevButtonNode = carousel.querySelector('.embla__prev')
            const nextButtonNode = carousel.querySelector('.embla__next')

            const emblaApi = EmblaCarousel(viewportNode, { loop: false })

            prevButtonNode?.addEventListener('click', () => emblaApi.scrollPrev(), false)
            nextButtonNode?.addEventListener('click', () => emblaApi.scrollNext(), false)
        }
    })
</script>

