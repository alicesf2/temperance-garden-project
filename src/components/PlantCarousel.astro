---
import { Carousel } from "flowbite";
import Plant from "./Plant.astro";
import type {
    CarouselItem,
    CarouselOptions,
    CarouselInterface,
} from "flowbite";

const { description, gifts } = Astro.props;
const { imgSrc, modalWidth, modalClass } = Astro.props.activePlant
---

<div id="indicators-carousel" class="size-full" data-carousel="static">
    <!-- Carousel wrapper -->
    <div class="relative h-full overflow-hidden rounded-base">
         <!-- Item 1 -->
        <div class="hidden duration-700 ease-in-out" data-carousel-item="active">
            <Plant
                id="primrose"
                imgSrc={imgSrc}
                imgWidth={modalWidth}
                class={modalClass}
            />
            <p class="text-3xl/snug text-body">
                {description}
            </p>
        </div>
        <!-- Item 2 -->
        <div class="hidden duration-700 ease-in-out" data-carousel-item>
            {gifts.map((gift: string, i: number) => (
                <span class="text-3xl/snug text-body">
                    {gift}{i < gifts.length - 1 && ", "}
                </span>
            ))}
        </div>
        <!-- Item 3 -->
        <div class="hidden duration-700 ease-in-out" data-carousel-item>
            <img src="/docs/images/carousel/carousel-3.svg" class="
              absolute top-1/2 left-1/2 block w-full -translate-1/2
            " alt="...">
        </div>
        <!-- Item 4 -->
        <div class="hidden duration-700 ease-in-out" data-carousel-item>
            <img src="/docs/images/carousel/carousel-4.svg" class="
              absolute top-1/2 left-1/2 block w-full -translate-1/2
            " alt="...">
        </div>
        <!-- Item 5 -->
        <div class="hidden duration-700 ease-in-out" data-carousel-item>
            <img src="/docs/images/carousel/carousel-5.svg" class="
              absolute top-1/2 left-1/2 block w-full -translate-1/2
            " alt="...">
        </div>
    </div>
    <!-- Slider indicators -->
    <div class="
      absolute bottom-10 left-1/2 z-30 flex -translate-x-1/2 space-x-3
      rtl:space-x-reverse
    ">
        <button type="button" class="size-3 rounded-base" aria-current="true" aria-label="Slide 1" data-carousel-slide-to="0"></button>
        <button type="button" class="size-3 rounded-base" aria-current="false" aria-label="Slide 2" data-carousel-slide-to="1"></button>
        <button type="button" class="size-3 rounded-base" aria-current="false" aria-label="Slide 3" data-carousel-slide-to="2"></button>
        <button type="button" class="size-3 rounded-base" aria-current="false" aria-label="Slide 4" data-carousel-slide-to="3"></button>
        <button type="button" class="size-3 rounded-base" aria-current="false" aria-label="Slide 5" data-carousel-slide-to="4"></button>
    </div>
    <!-- Slider controls -->
