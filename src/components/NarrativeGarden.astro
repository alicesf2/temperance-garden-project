---
import keykye from "../assets/keykye.png";
import speechBubble from "../assets/speech-bubble.png";
import ViewSelectDropdown from "./ViewSelectDropdown.astro";

const { narrative } = Astro.props;
---

<div
  id="narrative-wrapper"
  class="absolute left-1/2 z-40 flex w-full max-w-150 -translate-x-1/2 flex-row
  items-center justify-center p-4
  top-15
  lg:relative lg:top-6"
>
  <img
    src={keykye.src}
    class="w-20
      md:w-30"
  />
  <div id="narrative-speech" class="relative">
    <img src={speechBubble.src} class="w-auto lg:h-auto lg:w-105 h-32" />
    <div
      id="narrative"
      class="absolute inset-0 ml-10 px-2 py-4 font-narrative text-2xl/6
          lg:ml-8 lg:px-10 lg:py-4 lg:text-3xl/8"
    >
      <div
        id="narrative-text"
        data-plant={narrative.plantView}
        data-history={narrative.historyView}
        data-event={narrative.eventView}
      >
        {narrative.intro}
      </div>
      <div class="mt-2 hidden flex-col gap-2 text-lg lg:flex lg:flex-row lg:gap-2 lg:text-2xl">
        <button
          id="plant-view"
          class="cursor-pointer rounded-2xl px-4 whitespace-nowrap outline-2 hover:bg-gray-200"
        >
          Plants
        </button>
        <button
          id="history-view"
          class="cursor-pointer rounded-2xl px-4 whitespace-nowrap outline-2 hover:bg-gray-200"
        >
          History
        </button>
        <button
          id="event-view"
          class="cursor-pointer rounded-2xl px-4 whitespace-nowrap outline-2 hover:bg-gray-200"
        >
          Events
        </button>
      </div>
      <ViewSelectDropdown />
    </div>
  </div>
</div>

<script>
  import { isPlantView, isEventView, isHistoryView } from "../stores/garden";

  const plantViewBtn = document.getElementById("plant-view");
  const historyViewBtn = document.getElementById("history-view");
  const eventViewBtn = document.getElementById("event-view");

  const narrativeTextEl = document.getElementById("narrative-text");

  // Switch views on desktop
  plantViewBtn?.addEventListener("click", () => {
    isHistoryView.set(false);
    isEventView.set(false);
    isPlantView.set(!isPlantView.get());
  });

  historyViewBtn?.addEventListener("click", () => {
    isPlantView.set(false);
    isEventView.set(false);
    isHistoryView.set(!isHistoryView.get());
  });

  eventViewBtn?.addEventListener("click", () => {
    isPlantView.set(false);
    isHistoryView.set(false);
    isEventView.set(!isEventView.get());
  });

  isPlantView.subscribe((plantView) => {
    // Keep plant view button highlighted
    if (plantView) {
      plantViewBtn?.classList.add("bg-gray-300");
      // Change speech bubble text
      if (narrativeTextEl) {
        narrativeTextEl.textContent = narrativeTextEl.dataset.plant as string;
      }
    } else {
      plantViewBtn?.classList.remove("bg-gray-300");
    }
  });

  isHistoryView.subscribe((historyView) => {
    if (historyView) {
      historyViewBtn?.classList.add("bg-gray-300");

      if (narrativeTextEl) {
        narrativeTextEl.textContent = narrativeTextEl.dataset.history as string;
      }
    } else {
      historyViewBtn?.classList.remove("bg-gray-300");
    }
  });

  isEventView.subscribe((eventView) => {
    if (eventView) {
      eventViewBtn?.classList.add("bg-gray-300");

      if (narrativeTextEl) {
        narrativeTextEl.textContent = narrativeTextEl.dataset.event as string;
      }
    } else {
      eventViewBtn?.classList.remove("bg-gray-300");
    }
  });

  // Switch views on mobile
  const viewSelector = document.getElementById("view") as HTMLSelectElement;
  viewSelector?.addEventListener("change", () => {
    switch (viewSelector.value) {
      case "plants":
        isHistoryView.set(false);
        isEventView.set(false);
        isPlantView.set(!isPlantView.get());
        break;
      case "history":
        isPlantView.set(false);
        isEventView.set(false);
        isHistoryView.set(!isHistoryView.get());
        break;
      case "events":
        isPlantView.set(false);
        isHistoryView.set(false);
        isEventView.set(!isEventView.get());
        break;
      default:
        isPlantView.set(false);
        isHistoryView.set(false);
        isEventView.set(false);
    }
  });
</script>
