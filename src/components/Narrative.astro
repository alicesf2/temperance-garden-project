---
import { cx } from "../lib/utils";
import keykye from "../assets/keykye.png"
import speechBubble from "../assets/speech-bubble.png"

interface Props {
    narrative: string[];
    page: "intro"|"garden";
    options?: boolean;
}

const {narrative, page, options} = Astro.props;
---

<div id="narrative-wrapper" class={cx(`
  absolute left-1/2 z-20 flex w-full max-w-150 -translate-x-1/2 flex-row
  items-center justify-center p-4
`, page === "intro" ? `bottom-32` : `lg:relative`)}>
    <img src={keykye.src} class="
      w-20
      md:w-30
    " />
    <div id="narrative-speech" class="relative">
        <img src={speechBubble.src} />
        <div id="narrative" class="
          absolute inset-0 ml-6 w-full px-6 py-3 font-narrative text-3xl/6
          lg:ml-8 lg:px-10 lg:py-4 lg:text-4xl/8
        ">
            {
                narrative.map((line: string, i: number) => (
                    <p id={`narrative-${i}`} class={i == 0 ? "visible" : `
                      hidden
                    `}>{line}</p>
                ))
            }
            {options && (
                <div class="
                  mt-2 flex flex-col gap-2 text-lg
                  lg:flex-row lg:gap-2 lg:text-2xl
                ">
                    <button id="plant-view" class="
                      cursor-pointer rounded-2xl px-2 outline-2
                      hover:bg-gray-200
                    ">Plant species</button>
                    <button id="history-view" class="
                      cursor-pointer rounded-2xl px-2 outline-2
                      hover:bg-gray-200
                    ">Garden history</button>
                    <button id="event-view" class="
                      cursor-pointer rounded-2xl px-2 outline-2
                      hover:bg-gray-200
                    ">Past events</button>
                </div>
            )}
        </div>
    </div>
</div>

<script>
    import { isPlantView, isEventView, isHistoryView } from "../stores/garden";

    const plantViewBtn = document.getElementById("plant-view");
    const historyViewBtn = document.getElementById("history-view");
    const eventViewBtn = document.getElementById("event-view");

    plantViewBtn?.addEventListener("click", () => {
        isHistoryView.set(false);
        isEventView.set(false);
        isPlantView.set(!isPlantView.get());
    })

    historyViewBtn?.addEventListener("click", () => {
        isPlantView.set(false);
        isEventView.set(false);
        isHistoryView.set(!isHistoryView.get());
    })

    eventViewBtn?.addEventListener("click", () => {
        isPlantView.set(false);
        isHistoryView.set(false);
        isEventView.set(!isEventView.get());
    })
</script>