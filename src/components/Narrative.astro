---
import { cx } from "../lib/utils";
import keykye from "../assets/keykye.png"
import speechBubble from "../assets/speech-bubble.png"

interface Props {
    narrative: string[];
    position: "top"|"bottom";
    options: boolean;
}

const {narrative, position, options} = Astro.props;
---

<div id="narrative-wrapper" class={cx(`
  absolute left-1/2 z-20 flex w-full -translate-x-1/2 flex-row items-center p-4
`, position === "top" ? `top-8` : `bottom-32`)}>
    <img src={keykye.src} width={65} />
    <div id="narrative-speech" class="relative">
        <img src={speechBubble.src} class="w-full scale-105" />
        <div id="narrative" class="
          absolute inset-0 ml-8 p-3 font-narrative text-3xl/6
        ">
            {
                narrative.map((line: string, i: number) => (
                    <p id={`narrative-${i}`} class={i == 0 ? "visible" : `
                      hidden
                    `}>{line}</p>
                ))
            }
            {options && (
                <div class="flex flex-col gap-2 text-lg">
                    <button class="cursor-pointer rounded-2xl px-2 outline">Plant species</button>
                    <button class="cursor-pointer rounded-2xl px-2 outline">Garden history</button>
                    <button class="cursor-pointer rounded-2xl px-2 outline">Past events</button>
                </div>
            )}
        </div>
    </div>
</div>