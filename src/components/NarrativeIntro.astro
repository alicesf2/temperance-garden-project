---
import keykye from "../assets/keykye.png";
import speechBubble from "../assets/speech-bubble.png";

const { narrative } = Astro.props;
---

<div
  id="narrative-wrapper"
  class="absolute left-1/2 z-40 flex w-full max-w-150 -translate-x-1/2 flex-row
  items-center justify-center p-4 bottom-32"
>
  <img
    src={keykye.src}
    class="w-20
      md:w-30"
  />
  <div id="narrative-speech" class="relative">
    <img src={speechBubble.src} class="h-30 w-auto lg:h-auto lg:w-105" />
    <div
      id="narrative"
      class="absolute inset-0 ml-10 px-2 py-4 font-narrative text-2xl/6
          lg:ml-8 lg:px-10 lg:py-4 lg:text-3xl/8"
    >
      <div id="narrative-text">
        {narrative.map((line: string, i: number) => (
          <p id={`narrative-${i}`} class={i === 0 ? "visible" : `hidden`}>
            {line}
          </p>
        ))}
      </div>
    </div>
  </div>
</div>
