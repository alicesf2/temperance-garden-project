---
import pic1 from "../assets/sanctuary-sign.jpg";
import pic2 from "../assets/sanctuary-view.jpg";
import pic3 from "../assets/sanctuary-key.jpg";

const { event } = Astro.props;
---

<div class="embla__slide min-w-0 flex-[0_0_100%]">
    <h1 class="
      text-3xl
      lg:text-4xl
    ">{event.title}</h1>
    <p class="
      text-xl
      lg:text-2xl
    ">{event.date}</p>
    <p class="
      font-sans text-lg
      lg:mb-8
    ">{event.description}</p>
    <div class="flex flex-col gap-8">
        {[pic1, pic2, pic3].map(pic => (
            <img src={pic.src} />
            <figcaption>Photo caption</figcaption>
        ))}
    </div>
</div>