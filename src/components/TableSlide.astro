---
import SanityImage from "./SanityImage.astro";

const { event } = Astro.props;
---

<div class="embla__slide min-w-0 flex-[0_0_100%]">
    <h1 class="
      text-3xl
      lg:text-4xl
    ">{event.name}</h1>
    <p class="
      text-xl
      lg:text-2xl
    ">{event.date}</p>
    <p class="
      font-sans text-lg
      lg:mb-8
    ">{event.description}</p>
    <div class="flex flex-col gap-8">
        {event.images && event.images.map(image => (
            <SanityImage image={image} alt="placeholder"/>
            <figcaption>Photo caption</figcaption>
        ))}
    </div>
</div>