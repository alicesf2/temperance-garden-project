---
import type { Plant } from "../pages/garden.astro";
import "../styles/global.css";
import { cx } from "../lib/utils";

interface Props {
  plant: Plant;
}

const { id, title, scientific, description, modalPosition } = Astro.props.plant;
---

<div
  id={`${id}-modal`}
  tabindex="-1"
  aria-hidden="true"
  class={cx(
    `
      fixed inset-x-0 top-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full
      items-end justify-center overflow-x-hidden overflow-y-auto
      md:inset-0
    `, modalPosition === "top" ? "pb-[90%]" : "pb-30")
  }
>
  <div class="relative max-h-full w-full max-w-4xl p-4">
    <!-- Modal content -->
    <div
      class="
        relative rounded-base border border-default bg-neutral-primary-soft p-4
        font-narrative shadow-sm
        md:p-6
      "
    >
      <!-- Modal header -->
      <div
        class="
          flex items-center gap-8 border-b border-default pb-4
          md:pb-5
        "
      >
        <h3 class="text-2xl font-semibold text-heading capitalize">{title}</h3>
        <p class="text-lg">{scientific}</p>
        <button
          type="button"
          class="
            ms-auto inline-flex size-9 cursor-pointer items-center
            justify-center rounded-base bg-transparent text-sm text-body
            hover:bg-neutral-tertiary hover:text-heading
          "
          data-modal-hide={`${id}-modal`}
          data-modal-close-btn
        >
          <svg
            class="size-10"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18 17.94 6M18 18 6.06 6"
            >
            </path>
          </svg>
          <span class="sr-only">Close modal</span>
        </button>
      </div>
      <!-- Modal body -->
      <div class="
        space-y-4 py-4
        md:space-y-6 md:py-6
      ">
        <p class="text-2xl/snug text-body">
          {description}
        </p>
      </div>
    </div>
  </div>
</div>
