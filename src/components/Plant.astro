---
import { cx } from '../lib/utils';
import "../styles/global.css";

interface Props {
  id: string;
  imgSrc: string;
  imgWidth: number;
  class?: string;
}

const { id, imgSrc, imgWidth, class: className } = Astro.props;
---

<button
  id={id}
  class={cx("z-10", className)}
  data-plant-btn
  type="button"
>
  <img
    src={imgSrc}
    class="animate-sway cursor-pointer"
    width={`${imgWidth}px`}
  />
</button>
