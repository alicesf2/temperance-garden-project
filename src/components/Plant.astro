---
import { cx } from '../lib/utils';
import "../styles/global.css";

interface Props {
  id: string;
  imgSrc: string;
  imgWidth: number;
  class?: string;
  modalTarget?: string;
}

const { id, imgSrc, imgWidth, class: className, modalTarget } = Astro.props;
---

<button
  id={`${id}-btn`}
  class={cx("z-10", className)}
  data-modal-target={modalTarget}
  data-modal-toggle={modalTarget}
  data-plant-btn
  type="button"
>
  <img
    src={imgSrc}
    class="cursor-pointer"
    width={`${imgWidth}px`}
  />
</button>
