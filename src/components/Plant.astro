---
interface Props {
  id: string;
  imgSrc: string;
  imgWidth: number;
  modalTarget: string;
}

const { id, imgSrc, imgWidth, modalTarget } = Astro.props;
---

<button
  id={id}
  class="plant"
  data-modal-target={modalTarget}
  data-modal-toggle={modalTarget}
  type="button"
>
  <img
    src={imgSrc}
    class={`w-${imgWidth} drop-shadow-2xl drop-shadow-yellow-500/80 cursor-pointer`}
  />
</button>
