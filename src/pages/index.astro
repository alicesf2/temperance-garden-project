---
import Layout from "../layouts/Layout.astro";
import archieml from "archieml";
import gatesClosed from "../assets/gates-closed.png";
import gatesOpen from "../assets/gates-open.png";
import ustreetLogo from "../assets/ustreet-logo.png";
import viggy from "../assets/viggy.png";
import speechBubble from "../assets/speech-bubble.png";
import back from "../assets/back.png"
import next from "../assets/next.png"
import "../styles/global.css";

// Load data from TAG google doc
const DOC_ID = "1tzmdmsrIXQ9BB5Os0J69RV7G0R4AWWXwWJwsBe2_bwo";
const url = `https://docs.google.com/document/d/${DOC_ID}/export?format=txt`;
const text = await fetch(url).then((res) => res.text());
const data = archieml.load(text);
---

<Layout>
  <section id="landing" class="relative h-screen w-screen overflow-hidden">
    <img id="img-gates-closed" src={gatesClosed.src} class="
      absolute inset-0 h-screen w-screen object-cover opacity-100
      transition-opacity duration-700
    " />
    <img id="img-gates-open" src={gatesOpen.src} class="
      absolute inset-0 h-screen w-screen object-cover opacity-0
      transition-opacity duration-700
    " />
    <div class="absolute top-5 left-5">
      <a href="https://ustreetcommunity.org">
        <img class="w-12" src={ustreetLogo.src} />
      </a>
    </div>
    <!-- Narrative Section -->
    <div class="absolute bottom-32 flex flex-row items-center p-4">
      <img src={viggy.src} width={85} />
      <div id="narrative-wrapper" class="relative">
        <img src={speechBubble.src} class="w-full" />
        <div id="narrative" class="
          absolute inset-0 ml-8 p-3 font-narrative text-2xl/6
        ">
          {
            data.narrative.map((line: string, i: number) => (
              <p id={`narrative-${i}`} class={i == 0 ? "visible" : "hidden"}>{line}</p>
            ))
          }
        </div>
      </div>
    </div>
    <button id="btn-start" type="button" class="
      absolute bottom-12 left-1/2 -translate-x-1/2 px-4 py-3 outline
    ">Start</button>
    <div id="btn-container" class="
      absolute bottom-12 left-1/2 hidden -translate-x-1/2 flex-row gap-4
    ">
      <button id="btn-back" type="button"><img src={back.src} class="scale-50" /></button>
      <button id="btn-next" type="button"><img src={next.src} class="scale-50" /></button>
    </div>
  </section>
</Layout>

<script>
  // const enterBtn = document.getElementById("btn-enter");
  // const exitBtn = document.getElementById("btn-exit")
  const bgImage = document.getElementById("img-gates-closed");
  const bgImage2 = document.getElementById("img-gates-open");

  const startBtn = document.getElementById("btn-start");
  const btnContainer = document.getElementById("btn-container")
  const nextBtn = document.getElementById("btn-next");
  const backBtn = document.getElementById("btn-back");
  const lines = document.querySelectorAll("#narrative p");

  let activeIndex = 0;

  startBtn?.addEventListener("click", () => {
    // Start narrative
    lines[activeIndex].classList.replace("visible", "hidden");
    activeIndex = (activeIndex + 1) % lines.length;
    lines[activeIndex].classList.replace('hidden', 'visible');

    // Replace start button with next and back
    startBtn.classList.add("hidden")
    btnContainer?.classList.remove("hidden")
    btnContainer?.classList.add("flex")
  })

  nextBtn?.addEventListener("click", () => {
    if (nextBtn.textContent === "Enter") {
      // Trigger gate animation
      bgImage?.classList.add("opacity-0")
      bgImage?.classList.remove("opacity-100")

      bgImage2?.classList.add("opacity-100")
      bgImage2?.classList.remove("opacity-0")

      // Navigate to garden page
      bgImage?.addEventListener("transitionend", () => {
        window.location.href = "/garden"
      }, {once: true})
    }

    lines[activeIndex].classList.replace("visible", "hidden");
    activeIndex += 1;
    lines[activeIndex].classList.replace("hidden", "visible");

    if (activeIndex === lines.length - 1) {
      nextBtn.textContent = "Enter"
    }
   }
  );

  backBtn?.addEventListener("click", () => {
    if (activeIndex === 1) {
      startBtn?.classList.remove("hidden")
      btnContainer?.classList.remove("flex")
      btnContainer?.classList.add("hidden")
    }

    lines[activeIndex].classList.replace("visible", "hidden");
    activeIndex -= 1;
    lines[activeIndex].classList.replace('hidden', 'visible');
  })

  // enterBtn?.addEventListener("click", () => {
  //   // Trigger gate animation
  //   bgImage?.classList.add("opacity-0")
  //   bgImage?.classList.remove("opacity-100")

  //   bgImage2?.classList.add("opacity-100")
  //   bgImage2?.classList.remove("opacity-0")

  //   // Navigate to garden page
  //   bgImage?.addEventListener("transitionend", () => {
  //     window.location.href = "/garden"
  //   }, {once: true})
  // })

  // exitBtn?.addEventListener("click", () => {
  //   bgImage2?.classList.remove("opacity-100")
  //   bgImage2?.classList.add("opacity-0")

  //   bgImage?.classList.remove("opacity-0")
  //   bgImage?.classList.add("opacity-100")
  // })
</script>
