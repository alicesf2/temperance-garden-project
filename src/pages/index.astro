</script> -->

<script>
  import { Modal } from "flowbite";

  // select the two elements that we'll work with
  const $buttonElement: HTMLElement | null = document.querySelector(".plant");
  const $modalElement: HTMLElement | null =
    document.querySelector("#plant-modal");

  if ($modalElement) {
    const modal = new Modal($modalElement);

    $buttonElement?.addEventListener("click", () => {
      modal.show();
    });

    document
      .querySelectorAll("[data-modal-hide='plant-modal']")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          modal.hide();
        });
      });
  }
</script>
