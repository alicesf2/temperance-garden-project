---
import archieml from "archieml";
import gatesClosed from "../assets/gates-closed.png";
import "../styles/global.css";

// Load data from TAG google doc
const DOC_ID = "1tzmdmsrIXQ9BB5Os0J69RV7G0R4AWWXwWJwsBe2_bwo";
const url = `https://docs.google.com/document/d/${DOC_ID}/export?format=txt`;
const text = await fetch(url).then((res) => res.text());
const data = archieml.load(text);
---

<img src={gatesClosed.src} class="h-screen w-screen object-cover" />
<button
  type="button"
  class="
    absolute top-[75%] left-1/2 -translate-x-1/2 rounded-xl bg-amber-900 px-8
    py-4 text-5xl text-white outline-amber-900
  "
  >Enter</button
>
<button
  type="button"
  class="
    absolute top-[80%] left-1/2 -translate-x-1/2 rounded-xl bg-amber-900 px-8
    py-4 text-5xl text-white outline-amber-900
  "
  >Exit</button>
