---
import archieml from "archieml";
import Plant from "../components/Plant.astro";
import PlantModal from "../components/PlantModal.astro";
import primrose from "../assets/primrose.png";
import redbud from "../assets/redbud.png";
import background from "../assets/red-background.png"
import garden from "../assets/garden.png"
import sign from "../assets/wooden-sign.png"
import "../styles/global.css";
import { cx } from '../lib/utils';

// Load data from TAG google doc
const DOC_ID = "1tzmdmsrIXQ9BB5Os0J69RV7G0R4AWWXwWJwsBe2_bwo";
const url = `https://docs.google.com/document/d/${DOC_ID}/export?format=txt`;
const text = await fetch(url).then((res) => res.text());
const data = archieml.load(text);

export interface Plant {
  id: string;
  title: string;
  scientific: string;
  description: string;
}
---

<section class="relative h-screen w-screen items-center overflow-hidden p-6">
  <div id="narrative" class="
    absolute top-[8%] left-1/2 z-1000 w-[90%] -translate-x-1/2 font-fauna
    text-5xl font-semibold
  ">
    {
      data.narrative.map((line: string, i: number) => (
        <p id={`narrative-${i}`} class={i == 0 ? "visible" : "hidden"}>{line}</p>
      ))
    }
  </div>

  <img src={background.src} class="absolute inset-0 h-screen object-cover"/>
  <img src={garden.src} class="
    absolute top-[18%] left-1/2 -translate-x-1/2 scale-115
  " />
  <Plant
    id="primrose"
    imgSrc={primrose.src}
    imgWidth={175}
    modalTarget="primrose-modal"
    class="absolute top-[50%] [--glow-size:80px]"
  />
  <Plant
    id="eastern-redbud"
    imgSrc={redbud.src}
    imgWidth={800}
    modalTarget="eastern-redbud-modal"
    class="absolute top-[20%] right-[-2.5%] [--glow-size:40px] [--glow-opacity:1] [--glow-inner:15px]" />"
  />

  {data.plants.map((plant: Plant) => <PlantModal plant={plant} />)}

  <img src={sign.src} class="
    absolute bottom-4 left-1/2 -translate-x-1/2 scale-50
  "/>

  <div class="
    absolute top-[76.5%] left-1/2 flex -translate-x-1/2 flex-col gap-15
    font-fauna
  ">
    <button id="next" class="cursor-pointer text-5xl font-semibold text-white">Next</button>
    <button id="back" class="cursor-pointer text-5xl font-semibold text-white">Back</button>
  </div>
</section>

<script>
  import { Modal } from "flowbite";
  const nextBtn = document.getElementById("next");
  const backBtn = document.getElementById("back");
  const lines = document.querySelectorAll("#narrative p");

  let activeIndex = 0;

  nextBtn?.addEventListener("click", () => {
    lines[activeIndex].classList.replace("visible", "hidden");
    activeIndex = (activeIndex + 1) % lines.length;
    lines[activeIndex].classList.replace('hidden', 'visible');
   }
  );

  backBtn?.addEventListener("click", () => {
    lines[activeIndex].classList.replace("visible", "hidden");
    activeIndex = (activeIndex - 1 + lines.length) % lines.length;
    lines[activeIndex].classList.replace('hidden', 'visible');
  })
</script>
