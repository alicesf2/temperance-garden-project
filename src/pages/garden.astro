---
import archieml from "archieml";
import Plant from "../components/Plant.astro";
import PlantModal from "../components/PlantModal.astro";
import ustreetLogo from "../assets/ustreet-logo.png";
import garden from "../assets/garden.png"
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Narrative from "../components/Narrative.astro";
import back from "../assets/back.png"
import table from "../assets/table.png"
import { plants } from "../utils/plants";
import { cx } from "../lib/utils";
import TableModal from "../components/TableModal.astro";

// Load data from TAG google doc
const DOC_ID = "1tzmdmsrIXQ9BB5Os0J69RV7G0R4AWWXwWJwsBe2_bwo";
const url = `https://docs.google.com/document/d/${DOC_ID}/export?format=txt`;
const text = await fetch(url).then((res) => res.text());
const data = archieml.load(text);

export interface Plant {
  id: string;
  title: string;
  scientific: string;
  description: string;
  modalPosition: "top"|"bottom";
  gifts: string[];
}
---

<Layout>
  <section class="relative h-dvh w-screen overflow-hidden p-6">
    <!-- Ustreet logo and next event -->
    <div id="ustreet-logo" class="
      absolute top-5 left-5 z-60 flex flex-row gap-4
    ">
      <div>
        <a href="https://ustreetcommunity.org">
          <img class="w-12" src={ustreetLogo.src} />
        </a>
      </div>
      <div>
        <a href={data.eventUrl}>
          <p class="mb-0 font-narrative text-2xl underline">Next Event: {data.eventDate}</p>
        </a>
      </div>
    </div>

    <div>
      <Narrative narrative={[data.gardenCta]} page="garden" options />
    </div>

    <div class="relative z-50 mx-auto -mt-12 h-dvh w-full max-w-170">
      <img src={garden.src} />

      <button id="table" class="
        absolute top-85 left-95 z-49 -translate-x-1/2 cursor-pointer
        lg:left-110 lg:w-100
      " data-modal-target="table-modal" data-modal-toggle="table-modal">
        <img id="table" class="hover:drop-shadow-[0_0_15px_rgba(255,220,0,1)]" src={table.src} />
      </button>

      <!-- Render clickable plant images -->
      {plants.map(plant => (
        <Plant
          id={plant.id}
          imgSrc={plant.imgSrc}
          imgWidth={plant.imgWidth}
          class={plant.class}
          modalTarget={`${plant.id}-modal`}
        />
      ))}

      <!-- Render plant modal elements -->
      {data.plants.map((plant: Plant) => <PlantModal plant={plant} />)}

      <!-- Render table modal element -->
      <TableModal />

      <div class="
        absolute bottom-4 flex w-[90%] flex-row justify-between gap-8 px-4
      ">
        <button id="btn-back" type="button" class="left-[-9%]">
          <img src={back.src} class="h-18 w-auto" />
        </button>
        <input id="history-slider" type="range" min="0" max="1" step="0.2" value="1" />
      </div>
    </div>
  </section>
</Layout>

<script>
  import { Modal } from "flowbite";
  import { isPlantView, isEventView, isHistoryView } from "../stores/garden";

  const plantImgs = document.querySelectorAll<HTMLElement>("[data-plant-btn] > img");

  const plantViewBtn = document.getElementById("plant-view");
  const historyViewBtn = document.getElementById("history-view");
  const eventViewBtn = document.getElementById("event-view");

  const historySlider = document.getElementById("history-slider");

  const table = document.getElementById("table");

  isPlantView.subscribe((plantView) => {
    // Keep plant view button highlighted
    if (plantView) {
      plantViewBtn?.classList.add("bg-gray-200")
    } else {
      plantViewBtn?.classList.remove("bg-gray-200")
    }

    // Add swaying animation to plants
    plantImgs.forEach(plantImg => {
      if (plantImg) {
        if (plantView) {
          plantImg.classList.add("animate-pulse")
        } else {
          plantImg.classList.remove("animate-pulse")
        }
      }
    })
  });

  isHistoryView.subscribe((historyView) => {
    if (historyView) {
      historySlider?.classList.remove("hidden");
      historyViewBtn?.classList.add("bg-gray-200");
    } else {
      historySlider?.classList.add("hidden");
      historyViewBtn?.classList.remove("bg-gray-200");
    }
  })

  isEventView.subscribe((eventView) => {
    if (eventView) {
      table?.classList.add("animate-pulse");
      eventViewBtn?.classList.add("bg-gray-200");
    } else {
      table?.classList.remove("animate-pulse");
      eventViewBtn?.classList.remove("bg-gray-200");
    }
  })

  // Remove swaying animation when plant clicked
  plantImgs.forEach(plantImg => (
    plantImg.addEventListener("click", () => {
      plantImg.classList.remove("animate-pulse")
    })
  ))

  // Fix back button position
  const backBtn = document.getElementById("btn-back");
  const screenHeight = window.screen.height;

  if (screenHeight < 700) {
    backBtn?.classList.remove("bottom-2");
    backBtn?.classList.add("bottom-[-7%]")
  }

  backBtn?.addEventListener("click", () => {
    window.location.href = "/"
  })
</script>
